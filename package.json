{
    "name": "headless-erp",
    "version": "0.0.0",
    "private": true,
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "start": "vite preview --host 127.0.0.1 --port 3000 --strictPort",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:db": "vitest run --config vitest.db.config.ts",
        "e2e": "playwright test",
        "db:types:check": "node scripts/check-types.mjs",
        "db:start": "supabase start",
        "db:reset": "supabase db reset",
        "db:test": "supabase test db",
        "db:types": "supabase gen types typescript --local --schema public,app > src/types/database.ts",
        "db:types:linked": "supabase gen types typescript --linked --schema public,app > src/types/database.ts",
        "db:test:linked": "powershell -NoProfile -File scripts/pgtap-remote.ps1"
    },
    "dependencies": {
        "@fontsource/inter": "^5.3.0",
        "@hookform/resolvers": "^5.9.1",
        "@internationalized/date": "^3.12.4",
        "@react-aria/utils": "^3.34.1",
        "@react-stately/utils": "^3.12.1",
        "@supabase/supabase-js": "^2.117.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@tanstack/react-query": "^5.104.3",
        "@tanstack/react-router": "^1.170.44",
        "@tanstack/react-table": "^9.3.1",
        "@untitledui/file-icons": "^0.0.9",
        "@untitledui/icons": "^0.0.23",
        "@vitejs/plugin-react": "^6.1.2",
        "date-holidays": "^3.37.0",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.5.0",
        "motion": "^13.4.4",
        "next-themes": "^0.4.6",
        "nuqs": "^2.10.2",
        "qr-code-styling": "^1.9.2",
        "react": "^19.3.0",
        "react-aria": "^3.52.1",
        "react-aria-components": "^1.21.1",
        "react-dom": "^19.3.0",
        "react-hook-form": "^7.90.0",
        "react-hotkeys-hook": "^5.3.3",
        "react-stately": "^3.50.0",
        "recharts": "^3.10.1",
        "sanitize-html": "^2.18.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-react-aria-components": "^2.2.0",
        "vite": "^8.3.4",
        "zod": "^4.6.7",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@playwright/test": "^1.64.0",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/sanitize-html": "^2.16.2",
        "postcss": "^8.5.28",
        "supabase": "^2.120.0",
        "typescript": "^6.0.3",
        "vitest": "^5.0.4"
    }
}
